    "@earendil-works/pi-tui": ">=1.1.0 <1.2.0",
    "typebox": ">=1.3.7 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@pi/codex-usage-status": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pi/codex-usage-status": "0.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
